# 本地开发变量示例（wrangler dev 会读取同目录下的 .dev.vars）。
# 复制为 .dev.vars 后填入真实值：.dev.vars 已被 .gitignore 忽略，绝不会入库。
#
# 同时提醒：线上环境请用
#   npx wrangler secret put LLM_API_KEY
#   npx wrangler secret put VAPID_PRIVATE_KEY
#   npx wrangler secret put PROXY_SHARED_SECRET
# 写入，不要写进 wrangler.toml。

LLM_API_KEY=""
VAPID_PRIVATE_KEY=""
PROXY_SHARED_SECRET=""
