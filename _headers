# 说明：script-src 采用 sha256 白名单而非 'unsafe-inline'。
# 若修改 index.html 中的内联 <script>，必须重算哈希——tests/security.test.mjs 会校验并在 npm test 中报错提醒。
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; script-src 'self' https://cdn.jsdelivr.net 'sha256-K0j5g2VLfz3WqgL+QTuRwuA4liEDkrPxvpOGRy/z2Sg=' 'sha256-0srY+seuBcPk2d4P50xXe/Ywv77Go0iyWgOG9HWHCoA='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://chillin-api.2089700996jy.workers.dev https://chillin-bfc.pages.dev; worker-src 'self'; manifest-src 'self'

/sw.js
  Content-Type: text/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/version.json
  Content-Type: application/json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/js/version.js
  Content-Type: text/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/manifest.json
  Content-Type: application/json
  Cache-Control: no-cache

/style.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/app.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/js/*
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
