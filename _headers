# 说明：script-src 采用 sha256 白名单而非 'unsafe-inline'。
# Trusted Types 目前以 Report-Only 观察（不影响渲染）：确认无违规后再把下面这行
# 提升为强制的 Content-Security-Policy 指令即可。策略清单需同时放行 DOMPurify 自建策略。
# 哈希按「仓库中 LF 换行」的内容计算（部署产物即如此）；tests/security.test.mjs 会在 npm test 中校验。
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: require-trusted-types-for 'script'; trusted-types chillin#html dompurify
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; frame-src 'none'; script-src 'self' 'sha256-Mq81jcs71LPrFhsUMRnnXA3wRXBUjd2vzOxLfy+PRSc=' 'sha256-5+zDwXlOqyZqQHUII7XJ2cRjzyTxPEveaQDQC9oRLZ4='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://chillin-api.2089700996jy.workers.dev https://chillin-bfc.pages.dev; worker-src 'self'; manifest-src 'self'; upgrade-insecure-requests

/sw.js
  Content-Type: text/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/version.json
  Content-Type: application/json
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/js/version.js
  Content-Type: text/javascript
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/manifest.json
  Content-Type: application/json
  Cache-Control: no-cache

/style.css
  Content-Type: text/css; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/app.js
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store

/js/*
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate
  CDN-Cache-Control: no-store
